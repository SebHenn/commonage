# Copy this file to .env and choose your own values. Never commit .env.
POSTGRES_PASSWORD=change-me

# The first administrator, created on first start when the archive has no users yet.
# Use a password of at least 6 characters with an uppercase letter, a lowercase letter,
# a digit and a symbol. You can remove these lines after the first start.
COMMONAGE_ADMIN_EMAIL=admin@example.org
COMMONAGE_ADMIN_PASSWORD=change-me
