# Copy this file to .env and choose your own values. Never commit .env.
POSTGRES_PASSWORD=change-me

# The first administrator, created on first start when the archive has no users yet.
# Use a password of at least 12 characters, for example a few words in a row.
# You can remove these lines after the first start.
COMMONAGE_ADMIN_EMAIL=admin@example.org
COMMONAGE_ADMIN_PASSWORD=change-me

# Optional: fill a new, empty archive with made-up demo content, in English (en) or German (de).
# COMMONAGE_DEMO=en

# Only if you changed Commonage's code: where your version's source code is published (AGPL).
# COMMONAGE_SOURCE_URL=https://example.org/our-commonage
