@inject IConfiguration Configuration
@inject Commonage.Web.Operations.ArchiveProfile Profile
@inject SupportedLanguages Languages
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture;
    var rightToLeft = culture.TextInfo.IsRightToLeft;
    var pageTitle = ViewData["Title"] as string ?? ViewData["Title"]?.ToString();
    var identity = await Profile.GetAsync();
    var isPrivatePage = new[] { "/Admin", "/Account", "/Contribute" }.Any(p => (ViewContext.RouteData.Values["page"]?.ToString() ?? "").StartsWith(p, StringComparison.OrdinalIgnoreCase));
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var canManage = User.IsInRole(Commonage.Web.Identity.Roles.Admin) || User.IsInRole(Commonage.Web.Identity.Roles.Curator);
    string? Current(params string[] pages) => pages.Any(p => currentPage.StartsWith(p, StringComparison.OrdinalIgnoreCase)) ? "page" : null;
}
<!DOCTYPE html>
<html lang="@culture.Name" dir="@(rightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(pageTitle == identity.Name ? identity.Name : $"{pageTitle} - {identity.Name}")</title>
    @if (isPrivatePage || !identity.AllowSearchEngines)
    {
        <meta name="robots" content="noindex" />
    }
    @if (ViewData["Canonical"] is string canonical)
    {
        <link rel="canonical" href="@canonical" />
    }
    @if (!isPrivatePage && identity.AllowSearchEngines)
    {
        var address = Context.Request.BaseAddress();
        var preview = ViewData["LinkPreview"] as Commonage.Web.Search.LinkPreview
            ?? new Commonage.Web.Search.LinkPreview(pageTitle ?? identity.Name, identity.Text(ArchiveTextKind.Tagline), $"{address}{Context.Request.Path}");
        var image = preview.ImageUrl ?? (identity.LogoId is { } logo ? $"{address}/branding/{logo}/icon" : null);
        <link rel="alternate" type="application/atom+xml" title="@T["What is new in {0}", identity.Name]" href="@Commonage.Web.Search.PublicFeeds.FeedPath" />
        <meta property="og:site_name" content="@identity.Name" />
        <meta property="og:title" content="@preview.Title" />
        <meta property="og:type" content="@preview.Type" />
        <meta property="og:url" content="@preview.Url" />
        @if (preview.Description is not null)
        {
            <meta property="og:description" content="@preview.Description" />
            <meta name="description" content="@preview.Description" />
        }
        @if (image is not null)
        {
            <meta property="og:image" content="@image" />
            if (preview.ImageAlt is not null)
            {
                <meta property="og:image:alt" content="@preview.ImageAlt" />
            }
            <meta name="twitter:card" content="summary_large_image" />
        }
    }
    @if (identity.LogoId is { } iconId)
    {
        <link rel="icon" type="image/png" href="/branding/@iconId/favicon" />
        <link rel="apple-touch-icon" href="/branding/@iconId/icon" />
    }
    <link rel="stylesheet" href="@(rightToLeft ? "/lib/bootstrap/dist/css/bootstrap.rtl.min.css" : "/lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (identity.AccentColor is not null)
    {
        <link rel="stylesheet" href="@Commonage.Web.Operations.BrandingEndpoints.StylesheetPath?v=@identity.BrandingVersion" />
    }
    <noscript><link rel="stylesheet" href="~/css/nojs.css" asp-append-version="true" /></noscript>
</head>
<body class="d-flex flex-column min-vh-100">
    <a href="#main" class="visually-hidden-focusable position-absolute top-0 start-0 z-3 m-2 p-2 bg-white border rounded">@T["Skip to content"]</a>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom site-navbar">
            <div class="container">
                <a class="navbar-brand text-wrap" asp-area="" asp-page="/Index">
                    @if (identity.LogoId is { } logoId)
                    {
                        <img src="/branding/@logoId/logo" alt="" class="navbar-logo" />
                    }
                    @identity.Name
                </a>
                @* What visitors need is always visible, also on a phone. Only what signed-in people need folds away. *@
                <ul class="navbar-nav flex-row gap-3 me-auto">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Collections/Index" aria-current="@Current("/Collections", "/Items")">@T["Collections"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Search" aria-current="@Current("/Search")">@T["Search"]</a>
                    </li>
                </ul>
                @* In the header, because a visitor who does not read the page's language must find it first. *@
                <details class="language-picker">
                    <summary class="nav-link text-dark">
                        <span class="visually-hidden">@T["Language"]: </span><span lang="@culture.Name">@SupportedLanguages.NameOf(culture.Name)</span>
                    </summary>
                    <form method="post" asp-page="/SetLanguage" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="language-menu">
                        @foreach (var language in Languages.Codes)
                        {
                            <button type="submit" name="culture" value="@language" class="btn btn-link btn-sm language-button" lang="@language"
                                    aria-current="@(language == culture.Name ? "true" : null)">@SupportedLanguages.NameOf(language)</button>
                        }
                    </form>
                </details>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#account-menu" aria-controls="account-menu"
                            aria-expanded="false" aria-label="@T["Toggle navigation"]">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div id="account-menu" class="navbar-collapse collapse flex-sm-grow-0">
                        <div class="d-sm-flex gap-3">
                            @if (canManage)
                            {
                                <a class="nav-link text-dark" asp-area="" asp-page="/Admin/Index" aria-current="@Current("/Admin")">@T["Manage archive"]</a>
                            }
                            <a class="nav-link text-dark" asp-page="/Account/Password" aria-current="@Current("/Account/Password")">@T["Change password"]</a>
                            <form method="post" asp-page="/Account/Logout" class="d-flex">
                                <button type="submit" class="btn btn-link nav-link text-dark">@T["Log out"]</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </nav>
        @if (Commonage.Web.Demo.DemoContent.LanguageOf(Configuration) is not null)
        {
            <p class="demo-notice" role="note">@T["This is a demo archive. Everything in it, people and pictures included, is made up."]</p>
        }
    </header>
    <div class="container flex-grow-1 pt-3">
        <main id="main" tabindex="-1" class="pb-3" data-address="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")">
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success" role="status">@message</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger" role="alert">@error</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top text-muted py-3">
        <div class="container d-flex flex-wrap gap-3 align-items-center">
            @if (identity.NameIsSet)
            {
                <span>@identity.Name</span>
            }
            @if (identity.Text(ArchiveTextKind.About) is not null)
            {
                <a asp-page="/Info" asp-route-slug="about">@T["About this archive"]</a>
            }
            @if (identity.Text(ArchiveTextKind.Contact) is not null)
            {
                <a asp-page="/Info" asp-route-slug="contact">@T["Contact"]</a>
            }
            <a asp-page="/Info" asp-route-slug="privacy">@T["Privacy"]</a>
            @if (identity.Text(ArchiveTextKind.Imprint) is not null)
            {
                <a asp-page="/Info" asp-route-slug="imprint">@T["Imprint"]</a>
            }
            <span class="small">@T["Made with {0}", Commonage.Web.Operations.ArchiveIdentity.SoftwareName]</span>
            <a href="@Commonage.Web.SourceCode.UrlFrom(Configuration)" rel="noopener" class="small">@T["Source code"]</a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-page="/Account/Login" class="ms-auto">@T["Curator login"]</a>
            }
            else
            {
                @* Only for curators, who need it for updates and bug reports; visitors learn nothing about the software version. *@
                <span class="ms-auto small">@T["Version {0}", Commonage.Web.AppVersion.Current]</span>
            }
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
