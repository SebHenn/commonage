@model ArchiveItem
@inject Commonage.Web.Operations.ArchiveProfile Profile
@* An item as visitors see it. Curators see the same in a preview, with the pictures from their own address, because the
   public one only serves published items. *@
@{
    var mediaAddress = ViewData["MediaAddress"] as string ?? "/media";
    var title = ArchiveItem.ShownTitle(T, Model.Title);
    var count = Model.MediaFiles.Count;
    var number = 0;
    var identity = await Profile.GetAsync();
    var largePhotos = identity.LargePhotos;
    var rights = Model.RightsUri ?? identity.DefaultRightsUri;
}

<article class="item-layout @(Model.MediaFiles.Count > 0 ? "item-layout-with-media" : "")">
    <div class="item-head">
        <h1>@title</h1>
        @if (Model.DateText is not null)
        {
            @* Everything from that time, so that a date leads somewhere. *@
            @if (Model.DateFrom is not null || Model.DateTo is not null)
            {
                <p class="mb-0"><a asp-page="/Search" asp-route-from="@Model.DateFrom?.Year" asp-route-to="@Model.DateTo?.Year" class="item-date" title="@T["Everything from this time"]">@Model.DateText</a></p>
            }
            else
            {
                <p class="text-muted mb-0">@Model.DateText</p>
            }
        }
    </div>
    @if (Model.MediaFiles.Count > 0)
    {
        <div class="item-media">
            @if (count > 1)
            {
                <nav class="photo-strip d-print-none" aria-label="@T["Photos of this item"]">
                    <ol>
                        @{ var inStrip = 0; }
                        @foreach (var file in Model.MediaFiles)
                        {
                            inStrip++;
                            <li>
                                <a href="#photo-@inStrip" aria-label="@T["Photo {0} of {1}", inStrip, count]">
                                    <img src="@mediaAddress/@file.Id/thumbnail" alt="" loading="lazy" />
                                    <span aria-hidden="true">@inStrip</span>
                                </a>
                            </li>
                        }
                    </ol>
                </nav>
            }
            @foreach (var file in Model.MediaFiles)
            {
                number++;
                var alt = file.AltText ?? (count > 1 ? T["{0}, photo {1} of {2}", title, number, count].Value : title);
                var picture = number == 1 ? "eager" : "lazy";
                @* The first picture is what the page is about, so it does not wait. *@
                <figure id="photo-@number">
                    @if (largePhotos && file.HasLarge)
                    {
                        @* The browser's own view of a picture can already zoom, on every device, without any script. *@
                        <a href="@mediaAddress/@file.Id/large" class="photo-link">
                            <img src="@mediaAddress/@file.Id/preview" alt="@alt" width="@file.PreviewWidth" height="@file.PreviewHeight"
                                 class="media-preview rounded" loading="@picture" fetchpriority="@(number == 1 ? "high" : "auto")" />
                            <span class="d-print-none">@T["Open at full size"]</span>
                        </a>
                    }
                    else
                    {
                        <img src="@mediaAddress/@file.Id/preview" alt="@alt" width="@file.PreviewWidth" height="@file.PreviewHeight"
                             class="media-preview rounded" loading="@picture" fetchpriority="@(number == 1 ? "high" : "auto")" />
                    }
                    @if (count > 1 || file.Caption is not null)
                    {
                        <figcaption>
                            @if (count > 1)
                            {
                                <span class="photo-number">@T["Photo {0} of {1}", number, count]</span>
                            }
                            @file.Caption
                        </figcaption>
                    }
                </figure>
            }
        </div>
    }
    <div class="item-text prose">
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-preserve-lines">@Model.Description</p>
        }
        @if (Model.Contribution is { ShowName: true, ContributorName: { } contributorName })
        {
            <p class="text-muted">@T["Contributed by {0}", contributorName]</p>
        }
        @if (Model.Tags.Count > 0)
        {
            <h2 class="visually-hidden">@T["Tags"]</h2>
            <ul class="list-unstyled d-flex flex-wrap gap-2">
                @foreach (var tag in Model.Tags)
                {
                    <li><a asp-page="/Search" asp-route-tag="@tag.Name" class="badge rounded-pill text-bg-light border tag-link">@tag.Name</a></li>
                }
            </ul>
        }
        <section class="item-rights" aria-labelledby="reuse-heading">
            <h2 id="reuse-heading" class="h6 mb-1">@T["May I reuse this?"]</h2>
            <p class="mb-1">
                @RightsOptions.LabelOrAsk(T, rights)
                @if (rights is not null)
                {
                    <a href="@rights" rel="license noopener">@T["What this means"]</a>
                }
            </p>
            @if (Model.Credit is not null)
            {
                <p class="mb-1">@Model.Credit</p>
            }
            @if (identity.Text(ArchiveTextKind.Contact) is not null)
            {
                <p class="mb-0"><a asp-page="/Info" asp-route-slug="contact">@T["How to reach the archive"]</a></p>
            }
        </section>
        @if (ViewData["Citation"] is string citation && ViewData["Canonical"] is string address)
        {
            @* Both buttons only work with JavaScript, so it shows them. The line itself is there for everyone. *@
            <div class="item-share d-print-none">
                <button type="button" class="btn btn-sm btn-outline-primary" hidden data-share="@address" data-share-title="@title" data-done-text="@T["Link copied"]" aria-describedby="share-status">@T["Share"]</button>
                <span id="share-status" class="small ms-2" role="status"></span>
                <details class="mt-2">
                    <summary>@T["Cite this item"]</summary>
                    <p id="citation" class="mt-2 mb-2 text-break">@citation</p>
                    <button type="button" class="btn btn-sm btn-outline-secondary" hidden data-copy-from="citation" data-done-text="@T["Copied"]" aria-describedby="copy-status">@T["Copy"]</button>
                    <span id="copy-status" class="small ms-2" role="status"></span>
                </details>
            </div>
        }
    </div>
</article>
