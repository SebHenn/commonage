@model ItemSummary
@inject Commonage.Web.Operations.ArchiveProfile Profile
@{
    var showCollection = ViewData["ShowCollection"] is true;
    var material = (await Profile.GetAsync()).MaterialLanguage;
}

@* One item card: the picture (never for a record-only item, see ItemSummary), the title, the date. Shared by lists and stories. *@
<a asp-page="/Items/Details" asp-route-id="@Model.Id" class="item-card">
    @if (Model.ThumbnailMediaFileId is { } mediaFileId)
    {
        <img src="/media/@mediaFileId/thumbnail" srcset="/media/@mediaFileId/thumbnail 400w, /media/@mediaFileId/card 800w"
             sizes="(min-width: 992px) 25vw, (min-width: 768px) 33vw, 50vw" alt="" class="media-thumbnail" loading="lazy" />
    }
    else
    {
        <span class="media-thumbnail text-tile" aria-hidden="true"><span>@T["Text"]</span></span>
    }
    <span class="item-card-title" lang="@material">@Model.Title</span>
</a>
@if (Model.DateText is not null)
{
    <small class="d-block text-muted" lang="@material">@Model.DateText</small>
}
@if (showCollection)
{
    <small class="d-block text-muted" lang="@material">@Model.CollectionTitle</small>
}
