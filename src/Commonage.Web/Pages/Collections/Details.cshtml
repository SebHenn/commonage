@page "/collections/{id:int}"
@model Commonage.Web.Pages.Collections.DetailsModel
@{
    ViewData["Title"] = Model.Collection.Title;
}

<h1>@Model.Collection.Title</h1>
@if (!string.IsNullOrWhiteSpace(Model.Collection.Description))
{
    <p class="lead text-preserve-lines">@Model.Collection.Description</p>
}

@if (Model.Items.Count == 0)
{
    <p class="text-muted">@T["This collection has no published items yet."]</p>
}
else
{
    <ul class="list-unstyled row g-3">
        @foreach (var item in Model.Items)
        {
            <li class="col-6 col-md-4 col-lg-3">
                <a asp-page="/Items/Details" asp-route-id="@item.Id" class="d-block">
                    @if (item.ThumbnailMediaFileId is { } mediaFileId)
                    {
                        <img src="/media/@mediaFileId/thumbnail" alt="" class="media-thumbnail rounded mb-1" loading="lazy" />
                    }
                    else
                    {
                        <span class="media-thumbnail rounded mb-1 bg-light d-block" aria-hidden="true"></span>
                    }
                    @item.Title
                </a>
            </li>
        }
    </ul>
}
