@page "/collections/{id:int}"
@model Commonage.Web.Pages.Collections.DetailsModel
@inject Commonage.Web.Operations.ArchiveProfile Profile
@{
    var material = (await Profile.GetAsync()).MaterialLanguage;
    ViewData["Title"] = Model.Collection.Title;
    var address = $"{HttpContext.Request.BaseAddress()}/collections/{Model.Collection.Id}";
    ViewData["Canonical"] = address;
    ViewData["LinkPreview"] = new LinkPreview(Model.Collection.Title, LinkPreview.Shorten(Model.Collection.Description), address);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Collections/Index">@T["Collections"]</a></li>
    </ol>
</nav>

<h1 lang="@material">@Model.Collection.Title</h1>
@if (!string.IsNullOrWhiteSpace(Model.Collection.Description))
{
    <p class="lead text-preserve-lines prose" lang="@material">@Model.Collection.Description</p>
}

@if (Model.Items.TotalCount == 0)
{
    <p class="text-muted">@T["This collection has no published items yet."]</p>
}
else
{
    <form method="get" asp-page="/Search" role="search" class="input-group mb-4">
        <input type="hidden" name="collection" value="@Model.Collection.Id" />
        <label for="collection-search" class="visually-hidden">@T["Search this collection"]</label>
        <input id="collection-search" type="search" name="q" class="form-control" placeholder="@T["Search this collection"]" />
        <button type="submit" class="btn btn-outline-primary">@T["Search"]</button>
    </form>
    <p class="text-muted">@T["Items: {0}", Model.Items.TotalCount]</p>
    <partial name="_ItemCards" model="Model.Items.Items" />
    <partial name="_Pager" model="Model.Items" />
}
