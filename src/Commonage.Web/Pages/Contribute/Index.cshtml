@page "/contribute/{token}"
@model Commonage.Web.Pages.Contribute.IndexModel
@{
    ViewData["Title"] = Model.Link.Title;
}

<div class="col-lg-8">
    <h1>@Model.Link.Title</h1>
    @if (Model.Identity.NameIsSet)
    {
        <p class="text-muted">@T["This form belongs to {0}.", Model.Identity.Name]</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Link.Introduction))
    {
        <p class="text-preserve-lines">@Model.Link.Introduction</p>
    }
    @if (!Model.CanTakeContributions)
    {
        <p class="alert alert-warning" role="status">@T["This archive cannot take in anything new at the moment, because its storage is full. Please try again later."]</p>
    }
    else
    {
    <p class="text-muted">@T["A curator looks at everything sent in before it appears in the archive."]</p>

    <form method="post" enctype="multipart/form-data" data-warn-unsaved="@(ModelState.IsValid ? "" : "dirty")" data-send-once>
        <partial name="_ErrorSummary" />
        <input type="hidden" asp-for="FormStarted" />
        <div class="contact-field" aria-hidden="true">
            <label asp-for="Website">@T["Leave this field empty"]</label>
            <input asp-for="Website" tabindex="-1" autocomplete="off" />
        </div>

        <fieldset class="mb-4">
            <legend class="h4">@T["About the material"]</legend>
            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label"></label>
                <input asp-for="Input.Title" class="form-control" aria-describedby="title-help" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
                <div id="title-help" class="form-text">@T["A few words, for example: Flood in Mill Street"]</div>
            </div>
            <div class="mb-3">
                @* Written out, because asp-for would make the optional photos required in the browser. *@
                <label for="Files" class="form-label">@T["Photos (optional)"]</label>
                <input id="Files" type="file" name="Files" accept="@Commonage.Web.Media.ImageFormats.AcceptAttribute" multiple
                       class="form-control" aria-describedby="photos-help"
                       data-choose-text="@T["Choose photos"]" data-none-text="@T["No photos chosen"]" />
                <span asp-validation-for="Files" class="text-danger"></span>
                <div id="photos-help" class="form-text">@T["Up to {0} photos: JPEG, PNG, TIFF or WebP.", Commonage.Web.Pages.Contribute.IndexModel.MaxFiles]</div>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Date" class="form-label"></label>
                <input asp-for="Input.Date" class="form-control" aria-describedby="date-help date-result" data-date-result="date-result" />
                <span asp-validation-for="Input.Date" class="text-danger"></span>
                <div id="date-help" class="form-text">@T["As precisely as you know it, for example: 1953, March 1953, circa 1950, 1950s."]</div>
                <div id="date-result" class="form-text" role="status"></div>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label"></label>
                <textarea asp-for="Input.Description" class="form-control" rows="6" aria-describedby="description-help"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
                <div id="description-help" class="form-text">@T["Who or what can be seen, where and when, and how it came to you."]</div>
            </div>
        </fieldset>

        <fieldset class="mb-4" id="Input_Rights" tabindex="-1">
            <legend class="h4">@T["Who made it?"]</legend>
            @foreach (var (value, text) in new[]
            {
                (RightsStatement.CreatedByContributor, T["I made it myself, for example I took the photos."]),
                (RightsStatement.PermissionFromRightsHolder, T["Someone else made it, and I have their permission or inherited the rights."]),
                (RightsStatement.Unknown, T["I don't know who made it."]),
            })
            {
                <div class="form-check">
                    <input type="radio" asp-for="Input.Rights" value="@value" id="rights-@value" class="form-check-input" />
                    <label for="rights-@value" class="form-check-label">@text</label>
                </div>
            }
            <span asp-validation-for="Input.Rights" class="text-danger"></span>
            <div class="mt-3">
                <label asp-for="Input.RightsHolder" class="form-label"></label>
                <input asp-for="Input.RightsHolder" class="form-control" />
                <span asp-validation-for="Input.RightsHolder" class="text-danger"></span>
            </div>
        </fieldset>

        <fieldset class="mb-4">
            <legend class="h4">@T["About you"]</legend>
            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" autocomplete="name" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-describedby="email-help" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
                <div id="email-help" class="form-text">@T["Only used to ask you about what you send in."]</div>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Input.ShowName" class="form-check-input" />
                <label asp-for="Input.ShowName" class="form-check-label"></label>
            </div>
            <p class="form-text">@T["Only the archive's curators see your name and email address, unless you choose to have your name shown."]</p>
        </fieldset>

        <div class="form-check mb-4">
            <input asp-for="Input.Consent" class="form-check-input" data-required-message="@T["Please agree, so that we can include what you send in."]" />
            <label asp-for="Input.Consent" class="form-check-label">@Model.ConsentStatement</label>
            <div><span asp-validation-for="Input.Consent" class="text-danger"></span></div>
            @if (Model.Identity.Text(ArchiveTextKind.Contact) is not null)
            {
                <div class="form-text"><a asp-page="/Info" asp-route-slug="contact">@T["How to reach the archive"]</a></div>
            }
        </div>

        <button type="submit" class="btn btn-primary">@T["Send"]</button>
    </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
