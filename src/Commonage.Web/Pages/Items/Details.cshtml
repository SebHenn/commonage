@page "/items/{id:int}"
@model Commonage.Web.Pages.Items.DetailsModel
@inject Commonage.Web.Operations.ArchiveProfile Profile
@{
    ViewData["Title"] = Model.Item.Title;
    ViewData["Canonical"] = Model.Address;
    ViewData["Citation"] = Model.Citation;
    ViewData["LinkPreview"] = Model.Preview;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Collections/Index">@T["Collections"]</a></li>
        <li class="breadcrumb-item"><a asp-page="/Collections/Details" asp-route-id="@Model.Item.CollectionId">@Model.Item.Collection.Title</a></li>
    </ol>
</nav>

<partial name="_ItemArticle" model="Model.Item" />

@{
    var around = Model.Surroundings;
}
@if (around.Previous is not null || around.Next is not null)
{
    <nav class="item-neighbours d-print-none" aria-label="@T["Other items in {0}", Model.Item.Collection.Title]">
        @if (around.Previous is { } previous)
        {
            <a asp-page="/Items/Details" asp-route-id="@previous.Id" rel="prev">@T["Previous: {0}", previous.Title]</a>
        }
        @if (around.Next is { } next)
        {
            <a asp-page="/Items/Details" asp-route-id="@next.Id" rel="next" class="item-next">@T["Next: {0}", next.Title]</a>
        }
    </nav>
}
@if ((await Profile.GetAsync()).AcceptVisitorNotes)
{
    <section class="mt-5 d-print-none" aria-labelledby="tell-heading">
        <h2 id="tell-heading" class="h4">@T["Do you know more about this?"]</h2>
        @if (Model.Item.HelpWanted)
        {
            <p class="fw-semibold">@T["The curators are looking for help with this item."]</p>
        }
        <p>@T["Who is in the picture, where was it, is something wrong? Tell the curators."]</p>
        <a asp-page="/Items/Tell" asp-route-id="@Model.Item.Id" class="btn btn-outline-primary">@T["Tell us"]</a>
    </section>
}
@if (around.SameCollection.Count > 0)
{
    <section class="mt-5 d-print-none" aria-labelledby="more-from">
        <h2 id="more-from" class="h4">
            <a asp-page="/Collections/Details" asp-route-id="@Model.Item.CollectionId">@T["More from {0}", Model.Item.Collection.Title]</a>
        </h2>
        <partial name="_ItemCards" model="around.SameCollection" />
    </section>
}
@if (around.SameTime.Count > 0)
{
    <section class="mt-4 d-print-none" aria-labelledby="same-time">
        <h2 id="same-time" class="h4">
            <a asp-page="/Search" asp-route-from="@Model.Item.DateFrom?.Year" asp-route-to="@Model.Item.DateTo?.Year">@T["From the same time"]</a>
        </h2>
        <partial name="_ItemCards" model="around.SameTime" view-data='new ViewDataDictionary(ViewData) { ["ShowCollection"] = true }' />
    </section>
}
