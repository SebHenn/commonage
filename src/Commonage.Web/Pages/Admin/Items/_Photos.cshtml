@model Commonage.Web.Pages.Admin.Items.EditModel

<section class="mt-5" aria-labelledby="photos-heading">
    <h2 id="photos-heading" class="h4">@T["Photos"]</h2>
    <div id="photo-cards" class="row g-3 mb-3">
        @{ var number = 0; }
        @foreach (var file in Model.MediaFiles)
        {
            number++;
            <partial name="_PhotoCard" model="new Commonage.Web.Pages.Admin.Items.PhotoCard(file, Model.ItemId!.Value, Model.Back, Model.Input.AltTexts.GetValueOrDefault(file.Id), Model.Input.Captions.GetValueOrDefault(file.Id), Model.IdenticalFiles.GetValueOrDefault(file.Id), number, Model.MediaFiles.Count)" />
        }
    </div>
    <p id="photo-moved" class="visually-hidden" role="status"></p>
    <div data-photos-present hidden="@(Model.MediaFiles.Count == 0)">
        <p id="alt-help" class="form-text">@T["For people who cannot see the photo: who and what is in it, in a sentence. Saved together with the item."]</p>
        <p id="caption-help" class="form-text">@T["Everyone reads the caption under the photo, for example: Page 2, or The bakery from across the road. Words in it are not searched, so what matters for finding the item belongs in the description."]</p>
        @* So nobody has to scroll back to the form's own button. *@
        <p>
            @* Above the form on an untitled draft, which makes it the button Enter presses there. *@
            @if (Model.NamingOneAfterAnother)
            {
                <button type="submit" form="item-form" name="then" value="next" class="btn btn-sm btn-outline-primary">@T["Save and next"]</button>
            }
            else
            {
                <button type="submit" form="item-form" class="btn btn-sm btn-outline-primary">@T["Save"]</button>
            }
        </p>
    </div>
    <p class="text-muted small" data-preview-status>
        @if (Model.MediaFiles.Any(f => f.Status == ProcessingStatus.Pending))
        {
            @T["Previews are being created. Reload the page in a moment."]
        }
    </p>

    @if (Model.CanUpload)
    {
        <form method="post" asp-page-handler="Upload" asp-route-id="@Model.ItemId" asp-route-back="@Model.Back" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center" data-upload-queue>
            <label for="photo-upload" class="visually-hidden">@T["Choose photos"]</label>
            <input id="photo-upload" type="file" name="files" accept="@Commonage.Web.Media.ImageFormats.AcceptAttribute" multiple class="form-control w-auto"
                   data-val="true" data-val-required="@T["Please choose at least one photo."]"
                   data-choose-text="@T["Choose photos"]" data-none-text="@T["No photos chosen"]" data-count-text="@T["Photos chosen: {0}"]" />
            <button type="submit" class="btn btn-outline-primary">@T["Upload"]</button>
            <span data-valmsg-for="files" data-valmsg-replace="true" class="text-danger w-100"></span>
        </form>
        <p class="form-text">@T["JPEG, PNG, TIFF or WebP. The original file is kept unchanged and is only visible to curators."]</p>
    }
    else
    {
        <p class="alert alert-warning" role="status">@T["The disk is nearly full, so no photos can be added at the moment. Tell the person who runs the server."]</p>
    }
</section>
