@page "{id:int?}"
@model Commonage.Web.Pages.Admin.Items.EditModel
@{
    ViewData["Title"] = Model.ItemId is null ? T["New item"] : T["Edit: {0}", ArchiveItem.ShownTitle(T, Model.SavedTitle ?? "")];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@(Model.Back ?? Commonage.Web.Search.AdminItemList.Page)">@T["Items"]</a></li>
    </ol>
</nav>

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <h1 class="me-auto mb-0">@ViewData["Title"]</h1>
    @if (Model.CurrentStatus is { } status)
    {
        <partial name="_StatusBadge" model="status" />
    }
    @if (Model.CurrentStatus == ItemStatus.Published)
    {
        <a asp-page="/Items/Details" asp-route-id="@Model.ItemId">@T["View public page"]</a>
    }
    else if (Model.ItemId is not null)
    {
        <a asp-page="/Admin/Items/Preview" asp-route-id="@Model.ItemId">@T["Preview"]</a>
    }
    @if (Model.PreviousId is { } previousId)
    {
        <a asp-route-id="@previousId" asp-route-back="@Model.Back" rel="prev">@T["Previous item"]</a>
    }
    @if (Model.NextId is { } nextId)
    {
        <a asp-route-id="@nextId" asp-route-back="@Model.Back" rel="next">@T["Next item"]</a>
    }
</div>

@if (Model.IsUntitled)
{
    <p class="alert alert-info col-lg-8">@T["This draft has no title yet, and cannot be published without one. Give it a title that says what the photo shows."]</p>
}

@* In a review, the material comes first: it is what the decision is about. It is also what a title is written from. *@
@if (Model.CurrentStatus == ItemStatus.Submitted || Model.IsUntitled)
{
    <partial name="_Photos" model="Model" />
}

@if (Model.Contribution is { } contribution)
{
    <section class="card mb-4 col-lg-8" aria-labelledby="contribution-heading">
        <div class="card-body">
            <h2 id="contribution-heading" class="h5">@T["Contribution"]</h2>
            @if (Model.CurrentStatus == ItemStatus.Submitted)
            {
                <p>@T["Check the contribution, complete the details below, then publish it, accept it as a draft or reject it."]</p>
            }
            else if (Model.CurrentStatus == ItemStatus.Withdrawn)
            {
                <p>@T["The contributor withdrew their consent. The item stays hidden and cannot be published again. Delete it once it is no longer needed."]</p>
            }
            <dl class="row mb-0">
                <dt class="col-sm-4">@T["Sent in by"]</dt>
                <dd class="col-sm-8">
                    @if (contribution.PersonalDetailsRemovedAt is { } removedAt)
                    {
                        <span class="text-muted">@T["Name and email address removed on {0}", Dates.Day(removedAt)]</span>
                    }
                    else
                    {
                        @contribution.ContributorName
                        <span class="text-muted">(@(contribution.ShowName ? T["may be named publicly"] : T["not to be named publicly"]))</span>
                    }
                </dd>
                @if (contribution.ContributorEmail is not null)
                {
                    <dt class="col-sm-4">@T["Email address"]</dt>
                    <dd class="col-sm-8"><a href="mailto:@contribution.ContributorEmail">@contribution.ContributorEmail</a></dd>
                }
                <dt class="col-sm-4">@T["Who made it"]</dt>
                <dd class="col-sm-8">
                    @(contribution.Rights switch
                    {
                        RightsStatement.CreatedByContributor => T["The contributor"],
                        RightsStatement.PermissionFromRightsHolder => T["Someone else; the contributor has permission or inherited the rights"],
                        _ => T["Unknown"],
                    })
                    @if (contribution.RightsHolder is not null)
                    {
                        <br />@T["Photographer or author: {0}", contribution.RightsHolder]
                    }
                </dd>
                <dt class="col-sm-4">@T["Sent in"]</dt>
                <dd class="col-sm-8">
                    @Dates.Moment(contribution.SubmittedAt)
                    @if (contribution.ContributionLink is { } link)
                    {
                        <br /><a asp-page="/Admin/Contributions/Edit" asp-route-id="@link.Id">@link.Title</a>
                    }
                </dd>
                @if (contribution.ReferenceCode is { } referenceCode)
                {
                    <dt class="col-sm-4">@T["Reference"]</dt>
                    <dd class="col-sm-8">@referenceCode</dd>
                }
                <dt class="col-sm-4">@T["Consent"]</dt>
                <dd class="col-sm-8 mb-0">@contribution.ConsentText</dd>
            </dl>
            @if (contribution.PersonalDetailsRemovedAt is null || Model.CurrentStatus != ItemStatus.Withdrawn)
            {
                @if (contribution.PersonalDetailsRemovedAt is null)
                {
                    <details class="mt-3">
                        <summary>@T["Correct these details"]</summary>
                        <form method="post" asp-page-handler="ContributorDetails" asp-route-id="@Model.ItemId" asp-route-back="@Model.Back" class="mt-2">
                            <div class="mb-2">
                                <label for="contributor-name" class="form-label">@T["Name"]</label>
                                <input id="contributor-name" name="contributorName" value="@contribution.ContributorName" class="form-control" autocomplete="off" />
                            </div>
                            <div class="mb-2">
                                <label for="contributor-email" class="form-label">@T["Email address"]</label>
                                <input id="contributor-email" name="contributorEmail" type="email" value="@contribution.ContributorEmail" class="form-control" autocomplete="off" />
                            </div>
                            <div class="mb-2">
                                <label for="contributor-holder" class="form-label">@T["Name of the photographer or author, if known"]</label>
                                <input id="contributor-holder" name="contributorRightsHolder" value="@contribution.RightsHolder" class="form-control" autocomplete="off" />
                            </div>
                            <div class="form-check mb-2">
                                <input id="contributor-show" name="showName" type="checkbox" value="true" checked="@contribution.ShowName" class="form-check-input" />
                                <label for="contributor-show" class="form-check-label">@T["May be named publicly"]</label>
                            </div>
                            <button type="submit" class="btn btn-sm btn-outline-primary">@T["Save these details"]</button>
                        </form>
                    </details>
                }
                <h3 class="h6 mt-4">@T["If the contributor asks"]</h3>
                <div class="d-flex flex-wrap gap-2">
                    @if (contribution.PersonalDetailsRemovedAt is null)
                    {
                        <form method="post" asp-page-handler="RemoveContributorDetails" asp-route-id="@Model.ItemId"
                              data-confirm="@T["Remove the contributor's name and email address? The material, the rights statement and the consent text stay. This cannot be undone."]">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Remove name and email address"]</button>
                        </form>
                    }
                    @if (Model.CurrentStatus != ItemStatus.Withdrawn)
                    {
                        <form method="post" asp-page-handler="Withdraw" asp-route-id="@Model.ItemId"
                              data-confirm="@T["Mark this contribution as withdrawn? It is hidden at once and cannot be published again."]">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Mark as withdrawn"]</button>
                        </form>
                    }
                </div>
            }
        </div>
    </section>
}

@if (Model.SavedByOthers is { } saved)
{
    <section class="alert alert-warning col-lg-8" role="alert" aria-labelledby="conflict-heading">
        <h2 id="conflict-heading" class="h5">@T["Someone else changed this item while you were working on it"]</h2>
        <p>@T["Your changes are not saved yet. They are still in the form below. Compare them with the version saved by the other person. If you save again, your version replaces theirs."]</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">@T["Title"]</dt>
            <dd class="col-sm-9">@saved.Title</dd>
            <dt class="col-sm-3">@T["Date"]</dt>
            <dd class="col-sm-9">@saved.DateText</dd>
            <dt class="col-sm-3">@T["Tags"]</dt>
            <dd class="col-sm-9">@string.Join(", ", saved.Tags.Select(t => t.Name))</dd>
            <dt class="col-sm-3">@T["Description"]</dt>
            <dd class="col-sm-9 mb-0 text-preserve-lines">@saved.Description</dd>
        </dl>
    </section>
}

<form method="post" id="item-form" class="col-lg-8" enctype="@(Model.ItemId is null ? "multipart/form-data" : null)" data-warn-unsaved="@(Model.FormHasUnsavedText ? "dirty" : "")" data-send-once>
    <partial name="_ErrorSummary" />
    <input type="hidden" asp-for="Input.Version" />
    @if (Model.ItemId is null && Model.CanUpload)
    {
        @* With no asp-for: the browser would then require a photo, and an item does not need one. *@
        <div class="mb-3">
            <label for="files" class="form-label">@T["Photos"]</label>
            <input id="files" type="file" name="files" accept="@Commonage.Web.Media.ImageFormats.AcceptAttribute" multiple class="form-control" aria-describedby="files-help"
                   data-choose-text="@T["Choose photos"]" data-none-text="@T["No photos chosen"]" data-count-text="@T["Photos chosen: {0}"]"
                   data-max-total-bytes="@Commonage.Web.Pages.Admin.Items.EditModel.MaxUploadRequestBytes" data-too-much-text="@T["These photos are too much to send with the form. Save the item first, then add them: they are sent one at a time there."]" />
            <span data-valmsg-for="files" data-valmsg-replace="true" class="text-danger d-block"></span>
            <div id="files-help" class="form-text">@T["JPEG, PNG, TIFF or WebP. The original file is kept unchanged and is only visible to curators."] <a asp-page="/Admin/Items/AddMany" asp-route-collectionId="@Model.Input.CollectionId">@T["Each photo its own item? Add many photos at once."]</a></div>
        </div>
    }
    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.CollectionId" class="form-label"></label>
        <select asp-for="Input.CollectionId" asp-items="Model.CollectionOptions" class="form-select">
            <option value="">@T["Choose a collection"]</option>
        </select>
        <span asp-validation-for="Input.CollectionId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Date" class="form-label"></label>
        <input asp-for="Input.Date" class="form-control" aria-describedby="date-help date-result" data-date-result="date-result" />
        <span asp-validation-for="Input.Date" class="text-danger"></span>
        <div id="date-help" class="form-text">
            @T["Write the date as precisely as it is known, for example: 1953, 12.03.1953, March 1953, circa 1950, 1950s, 1950–1955, before 1945."]
        </div>
        <div id="date-result" class="form-text" role="status">
            @if (Model.CurrentDateRange is { } range)
            {
                @T["Found when visitors filter by: {0}", range]
            }
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Tags" class="form-label"></label>
        <input asp-for="Input.Tags" class="form-control" aria-describedby="tags-help" />
        <span asp-validation-for="Input.Tags" class="text-danger"></span>
        <div id="tags-help" class="form-text">@T["Places, people or topics, separated by commas."]</div>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="8"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>

    <partial name="_Catalogue" model="Model" />

    <div class="d-flex flex-wrap gap-2">
        @switch (Model.CurrentStatus)
        {
            case ItemStatus.Published:
                <button type="submit" class="btn btn-primary">@T["Save"]</button>
                @if (Model.NextId is not null)
                {
                    <button type="submit" name="then" value="next" class="btn btn-outline-primary">@T["Save and next"]</button>
                }
                <button type="submit" name="command" value="unpublish" class="btn btn-outline-danger">@T["Unpublish"]</button>
                break;
            case ItemStatus.Submitted:
                <button type="submit" name="command" value="publish" class="btn btn-primary">@T["Save and publish"]</button>
                <button type="submit" name="command" value="accept" class="btn btn-outline-primary">@T["Accept as draft"]</button>
                <button type="submit" name="command" value="reject" class="btn btn-outline-danger">@T["Reject"]</button>
                break;
            case ItemStatus.Rejected:
                <button type="submit" class="btn btn-outline-primary">@T["Save"]</button>
                <button type="submit" name="command" value="accept" class="btn btn-outline-primary">@T["Accept as draft"]</button>
                break;
            case ItemStatus.Withdrawn:
                <button type="submit" class="btn btn-outline-primary">@T["Save"]</button>
                break;
            default:
                @* On a new item, saving is the usual thing to do: most are not ready for visitors the moment they are typed in. *@
                @if (Model.NamingOneAfterAnother)
                {
                    <button type="submit" name="then" value="next" class="btn btn-primary">@T["Save and next"]</button>
                }
                <button type="submit" class="btn @(Model.ItemId is null ? "btn-primary" : "btn-outline-primary")">@T["Save as draft"]</button>
                @if (Model.NextId is not null && !Model.NamingOneAfterAnother)
                {
                    <button type="submit" name="then" value="next" class="btn btn-outline-primary">@T["Save and next"]</button>
                }
                @if (Model.ItemId is null)
                {
                    <button type="submit" name="then" value="another" class="btn btn-outline-primary">@T["Save and add another"]</button>
                }
                <button type="submit" name="command" value="publish" class="btn @(Model.ItemId is null || Model.NamingOneAfterAnother ? "btn-outline-primary" : "btn-primary")">@T["Save and publish"]</button>
                break;
        }
    </div>
</form>

@if (Model.ItemId is not null && Model.CurrentStatus != ItemStatus.Submitted && !Model.IsUntitled)
{
    <partial name="_Photos" model="Model" />
}

@if (Model.ItemId is not null)
{
    @if (Model.History.Count > 0)
    {
        <section class="mt-5 col-lg-8" aria-labelledby="history-heading">
            <h2 id="history-heading" class="h4">@T["History"]</h2>
            <ul class="list-unstyled small">
                @foreach (var entry in Model.History)
                {
                    <li class="mb-1">
                        <time datetime="@entry.At.ToString("O")" class="text-muted">@Dates.Moment(entry.At)</time>
                        · @AuditText.Describe(T, entry.Action)
                        · @AuditText.Who(T, entry)
                    </li>
                }
            </ul>
        </section>
    }

    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.ItemId" class="mt-5"
          data-confirm="@T["Move this item to the bin? It disappears from the archive at once. You can restore it there for {0} days.", Commonage.Web.Data.ArchiveBin.RetentionDays]">
        <button type="submit" class="btn btn-outline-danger">@T["Move to bin"]</button>
    </form>
}

<partial name="_UploadTexts" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/uploads.js" asp-append-version="true"></script>
}
