@page "{id:int?}"
@model Commonage.Web.Pages.Admin.Items.EditModel
@{
    ViewData["Title"] = Model.ItemId is null ? T["New item"] : T["Edit item"];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Admin/Index">@T["Items"]</a></li>
    </ol>
</nav>

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <h1 class="me-auto mb-0">@ViewData["Title"]</h1>
    @if (Model.CurrentStatus is { } status)
    {
        <partial name="_StatusBadge" model="status" />
    }
    @if (Model.CurrentStatus == ItemStatus.Published)
    {
        <a asp-page="/Items/Details" asp-route-id="@Model.ItemId">@T["View public page"]</a>
    }
</div>

@if (Model.Contribution is { } contribution)
{
    <section class="card mb-4 col-lg-8" aria-labelledby="contribution-heading">
        <div class="card-body">
            <h2 id="contribution-heading" class="h5">@T["Contribution"]</h2>
            @if (Model.CurrentStatus == ItemStatus.Submitted)
            {
                <p>@T["Check the contribution, complete the details below, then publish it, accept it as a draft or reject it."]</p>
            }
            else if (Model.CurrentStatus == ItemStatus.Withdrawn)
            {
                <p>@T["The contributor withdrew their consent. The item stays hidden and cannot be published again. Delete it once it is no longer needed."]</p>
            }
            <dl class="row mb-0">
                <dt class="col-sm-4">@T["Sent in by"]</dt>
                <dd class="col-sm-8">
                    @if (contribution.PersonalDetailsRemovedAt is { } removedAt)
                    {
                        <span class="text-muted">@T["Name and email address removed on {0}", removedAt.ToLocalTime().ToString("d")]</span>
                    }
                    else
                    {
                        @contribution.ContributorName
                        <span class="text-muted">(@(contribution.ShowName ? T["may be named publicly"] : T["not to be named publicly"]))</span>
                    }
                </dd>
                @if (contribution.ContributorEmail is not null)
                {
                    <dt class="col-sm-4">@T["Email address"]</dt>
                    <dd class="col-sm-8"><a href="mailto:@contribution.ContributorEmail">@contribution.ContributorEmail</a></dd>
                }
                <dt class="col-sm-4">@T["Who made it"]</dt>
                <dd class="col-sm-8">
                    @(contribution.Rights switch
                    {
                        RightsStatement.CreatedByContributor => T["The contributor"],
                        RightsStatement.PermissionFromRightsHolder => T["Someone else; the contributor has permission or inherited the rights"],
                        _ => T["Unknown"],
                    })
                    @if (contribution.RightsHolder is not null)
                    {
                        <br />@T["Photographer or author: {0}", contribution.RightsHolder]
                    }
                </dd>
                <dt class="col-sm-4">@T["Sent in"]</dt>
                <dd class="col-sm-8">
                    @contribution.SubmittedAt.ToLocalTime().ToString("g")
                    @if (contribution.ContributionLink is { } link)
                    {
                        <br /><a asp-page="/Admin/Contributions/Edit" asp-route-id="@link.Id">@link.Title</a>
                    }
                </dd>
                <dt class="col-sm-4">@T["Consent"]</dt>
                <dd class="col-sm-8 mb-0">@contribution.ConsentText</dd>
            </dl>
            @if (contribution.PersonalDetailsRemovedAt is null || Model.CurrentStatus != ItemStatus.Withdrawn)
            {
                <h3 class="h6 mt-4">@T["If the contributor asks"]</h3>
                <div class="d-flex flex-wrap gap-2">
                    @if (contribution.PersonalDetailsRemovedAt is null)
                    {
                        <form method="post" asp-page-handler="RemoveContributorDetails" asp-route-id="@Model.ItemId"
                              data-confirm="@T["Remove the contributor's name and email address? The material, the rights statement and the consent text stay. This cannot be undone."]">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Remove name and email address"]</button>
                        </form>
                    }
                    @if (Model.CurrentStatus != ItemStatus.Withdrawn)
                    {
                        <form method="post" asp-page-handler="Withdraw" asp-route-id="@Model.ItemId"
                              data-confirm="@T["Mark this contribution as withdrawn? It is hidden at once and cannot be published again."]">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Mark as withdrawn"]</button>
                        </form>
                    }
                </div>
            }
        </div>
    </section>
}

<form method="post" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.CollectionId" class="form-label"></label>
        <select asp-for="Input.CollectionId" asp-items="Model.CollectionOptions" class="form-select">
            <option value="">@T["Choose a collection"]</option>
        </select>
        <span asp-validation-for="Input.CollectionId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Date" class="form-label"></label>
        <input asp-for="Input.Date" class="form-control" aria-describedby="date-help" />
        <span asp-validation-for="Input.Date" class="text-danger"></span>
        <div id="date-help" class="form-text">
            @T["Write the date as precisely as it is known, for example: 1953, 12.03.1953, March 1953, circa 1950, 1950s, 1950–1955, before 1945."]
            @if (Model.CurrentDateRange is { } range)
            {
                <br />@T["Found when visitors filter by: {0}", range]
            }
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Tags" class="form-label"></label>
        <input asp-for="Input.Tags" class="form-control" aria-describedby="tags-help" />
        <span asp-validation-for="Input.Tags" class="text-danger"></span>
        <div id="tags-help" class="form-text">@T["Places, people or topics, separated by commas."]</div>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="8"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @switch (Model.CurrentStatus)
        {
            case ItemStatus.Published:
                <button type="submit" class="btn btn-primary">@T["Save"]</button>
                <button type="submit" name="command" value="unpublish" class="btn btn-outline-danger">@T["Unpublish"]</button>
                break;
            case ItemStatus.Submitted:
                <button type="submit" name="command" value="publish" class="btn btn-primary">@T["Save and publish"]</button>
                <button type="submit" name="command" value="accept" class="btn btn-outline-primary">@T["Accept as draft"]</button>
                <button type="submit" name="command" value="reject" class="btn btn-outline-danger">@T["Reject"]</button>
                break;
            case ItemStatus.Rejected:
                <button type="submit" class="btn btn-outline-primary">@T["Save"]</button>
                <button type="submit" name="command" value="accept" class="btn btn-outline-primary">@T["Accept as draft"]</button>
                break;
            case ItemStatus.Withdrawn:
                <button type="submit" class="btn btn-outline-primary">@T["Save"]</button>
                break;
            default:
                <button type="submit" class="btn btn-outline-primary">@T["Save as draft"]</button>
                <button type="submit" name="command" value="publish" class="btn btn-primary">@T["Save and publish"]</button>
                break;
        }
    </div>
</form>

<section class="mt-5" aria-labelledby="photos-heading">
    <h2 id="photos-heading" class="h4">@T["Photos"]</h2>
    @if (Model.ItemId is null)
    {
        <p class="text-muted">@T["Save the item first, then add photos."]</p>
    }
    else
    {
        @if (Model.MediaFiles.Count > 0)
        {
            <div class="row g-3 mb-3">
                @foreach (var file in Model.MediaFiles)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card h-100">
                            @if (file.Status == ProcessingStatus.Ready)
                            {
                                <img src="/admin/media/@file.Id/thumbnail" class="card-img-top media-thumbnail" alt="@file.OriginalFileName" loading="lazy" />
                            }
                            else
                            {
                                <div class="card-img-top media-thumbnail d-flex align-items-center justify-content-center bg-light text-muted small p-2 text-center">
                                    @(file.Status == ProcessingStatus.Pending ? T["Creating preview…"] : T["No preview could be created."])
                                </div>
                            }
                            <div class="card-body p-2 small">
                                <div class="text-truncate" title="@file.OriginalFileName">@file.OriginalFileName</div>
                                <div class="text-muted">@((file.SizeBytes / 1024.0 / 1024.0).ToString("0.0")) MB</div>
                                <div class="d-flex flex-wrap gap-2 mt-1">
                                    <a href="/admin/media/@file.Id/original">@T["Original"]</a>
                                    <form method="post" asp-page-handler="DeleteMedia" asp-route-id="@Model.ItemId" asp-route-mediaFileId="@file.Id"
                                          data-confirm="@T["Delete this photo and its original file?"]">
                                        <button type="submit" class="btn btn-link btn-sm p-0 text-danger">@T["Delete"]</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (Model.MediaFiles.Any(f => f.Status == ProcessingStatus.Pending))
            {
                <p class="text-muted small">@T["Previews are being created. Reload the page in a moment."]</p>
            }
        }

        <form method="post" asp-page-handler="Upload" asp-route-id="@Model.ItemId" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center">
            <label for="photo-upload" class="visually-hidden">@T["Choose photos"]</label>
            <input id="photo-upload" type="file" name="files" accept="@Commonage.Web.Media.ImageFormats.AcceptAttribute" multiple class="form-control w-auto" required />
            <button type="submit" class="btn btn-outline-primary">@T["Upload"]</button>
        </form>
        <p class="form-text">@T["JPEG, PNG, TIFF or WebP. The original file is kept unchanged and is only visible to curators."]</p>
    }
</section>

@if (Model.ItemId is not null)
{
    @if (Model.History.Count > 0)
    {
        <section class="mt-5 col-lg-8" aria-labelledby="history-heading">
            <h2 id="history-heading" class="h4">@T["History"]</h2>
            <ul class="list-unstyled small">
                @foreach (var entry in Model.History)
                {
                    <li class="mb-1">
                        <time datetime="@entry.At.ToString("O")" class="text-muted">@entry.At.ToLocalTime().ToString("g")</time>
                        · @AuditText.Describe(T, entry.Action)
                        · @(entry.UserName ?? T["Contributor"])
                    </li>
                }
            </ul>
        </section>
    }

    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.ItemId" class="mt-5"
          data-confirm="@T["Delete this item with all its photos and original files? This cannot be undone."]">
        <button type="submit" class="btn btn-outline-danger">@T["Delete item"]</button>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
