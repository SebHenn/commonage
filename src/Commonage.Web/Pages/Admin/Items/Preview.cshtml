@page "{id:int}"
@model Commonage.Web.Pages.Admin.Items.PreviewModel
@{
    ViewData["Title"] = T["Preview: {0}", ArchiveItem.ShownTitle(T, Model.Item.Title)];
    ViewData["MediaAddress"] = "/admin/media";
}

<div class="alert alert-info d-flex flex-wrap gap-2 align-items-center" role="status">
    <span class="me-auto">
        @if (Model.Item.Status != ItemStatus.Published)
        {
            @T["Preview. Visitors cannot see this item."]
        }
        else if (Model.Item.PublicFrom is { } publicFrom && publicFrom > Model.Today)
        {
            @T["Preview. Public from {0}.", publicFrom.ToString("d", System.Globalization.CultureInfo.CurrentCulture)]
        }
        else if (Model.Item.MediaLevel == MediaLevel.RecordOnly)
        {
            @T["Preview. Visitors see the record only, without its pictures and recordings."]
        }
        else
        {
            @T["Preview. This item is public."]
        }
    </span>
    <a asp-page="/Admin/Items/Edit" asp-route-id="@Model.Item.Id" class="alert-link">@T["Back to editing"]</a>
</div>

<partial name="_ItemArticle" model="Model.Item" view-data="ViewData" />
