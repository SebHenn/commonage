@* What uploads.js says, in the language of the page. *@
<div id="upload-texts" hidden
     data-waiting="@T["Waiting"]"
     data-sending="@T["Sending…"]"
     data-added="@T["Added"]"
     data-add-anyway="@T["Add anyway"]"
     data-count="@T["Finished: {0} of {1}"]"
     data-sent-now="@T["Sending: {0}"]"
     data-done="@T["Finished. Added: {0}. Already in the archive: {1}. Refused: {2}."]"
     data-resume="@T["Continue"]"
     data-connection="@T["The connection to the archive was lost. The photos that arrived are safe. Continue when the connection is back."]"
     data-login="@T["You are no longer logged in. Log in again in another tab, then continue."]"
     data-login-link="@T["Log in"]"
     data-full="@T["The disk is nearly full, so no photos can be added at the moment. Tell the person who runs the server."]"
     data-rejected="@T["The archive did not accept this. Reload the page, choose the photos that are missing and try again."]"
     data-too-large="@T["{0} is too large."]"
     data-queue-label="@T["Photos on their way"]"></div>
