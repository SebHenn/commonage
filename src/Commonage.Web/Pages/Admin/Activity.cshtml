@page
@model Commonage.Web.Pages.Admin.ActivityModel
@{
    ViewData["Title"] = T["Activity log"];
}

<h1>@ViewData["Title"]</h1>
<p class="col-lg-8">@T["Who changed what in the archive, newest first. The log keeps no contributor details, and nobody can change or delete its entries in the app. Entries older than the archive keeps them, as set in the settings, are deleted, and the log notes that."]</p>

<form method="get" role="search" aria-label="@T["Filter the activity log"]" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-lg-3">
        <label for="activity-who" class="form-label">@T["Who"]</label>
        <select id="activity-who" name="who" class="form-select">
            <option value="">@T["Everyone"]</option>
            @foreach (var person in Model.People)
            {
                <option value="@person" selected="@(Model.Who == person)">@person</option>
            }
            <option value="@ActivityModel.Contributors" selected="@(Model.Who == ActivityModel.Contributors)">@T["Contributor"]</option>
            <option value="@ActivityModel.Automatic" selected="@(Model.Who == ActivityModel.Automatic)">@T["Automatic"]</option>
        </select>
    </div>
    <div class="col-sm-6 col-lg-3">
        <label for="activity-what" class="form-label">@T["What"]</label>
        <select id="activity-what" name="what" class="form-select">
            <option value="">@T["Everything"]</option>
            @foreach (var kind in Enum.GetValues<Commonage.Web.Audit.AuditKind>())
            {
                <option value="@kind" selected="@(Model.What == kind)">@Commonage.Web.Audit.AuditText.Describe(T, kind)</option>
            }
        </select>
    </div>
    <div class="col-sm-8 col-lg-4">
        <label for="activity-text" class="form-label">@T["Title or name"]</label>
        <input id="activity-text" type="search" name="q" value="@Model.Text" class="form-control" />
    </div>
    <div class="col-auto d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-outline-primary">@T["Filter"]</button>
        @if (Model.IsFiltered)
        {
            <a asp-page="/Admin/Activity" class="btn btn-link">@T["Show everything"]</a>
        }
    </div>
</form>

@if (Model.Entries.TotalCount == 0)
{
    <p class="text-muted">@(Model.IsFiltered ? T["No entries match."] : T["Nothing has been recorded yet."])</p>
}
else
{
    @* Its rows have nothing to focus, so on a phone the region itself takes the focus, to be scrolled with the keyboard. *@
    <div class="table-responsive" tabindex="0" role="region" aria-label="@T["Activity log"]">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">@T["When"]</th>
                    <th scope="col">@T["Who"]</th>
                    <th scope="col">@T["What"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Entries.Items)
                {
                    <tr>
                        <td class="text-nowrap"><time datetime="@entry.At.ToString("O")">@Dates.Moment(entry.At)</time></td>
                        <td class="text-break">@AuditText.Who(T, entry)</td>
                        <td>
                            @AuditText.Describe(T, entry.Action)@if (entry.Subject is not null)
                            {
                                <text>: </text>
                                @if (entry.ArchiveItemId is { } itemId)
                                {
                                    <a asp-page="/Admin/Items/Edit" asp-route-id="@itemId">@ArchiveItem.ShownTitle(T, entry.Subject)</a>
                                }
                                else
                                {
                                    @ArchiveItem.ShownTitle(T, entry.Subject)
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Entries" />
}
