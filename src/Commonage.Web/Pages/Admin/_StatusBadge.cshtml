@model ItemStatus
@switch (Model)
{
    case ItemStatus.Published:
        <span class="badge text-bg-success">@T["Published"]</span>
        break;
    case ItemStatus.Submitted:
        <span class="badge text-bg-warning">@T["Submitted"]</span>
        break;
    case ItemStatus.Rejected:
        <span class="badge text-bg-danger">@T["Rejected"]</span>
        break;
    case ItemStatus.Withdrawn:
        <span class="badge text-bg-dark">@T["Withdrawn"]</span>
        break;
    default:
        <span class="badge text-bg-secondary">@T["Draft"]</span>
        break;
}
