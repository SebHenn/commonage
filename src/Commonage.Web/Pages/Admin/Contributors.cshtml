@page
@model Commonage.Web.Pages.Admin.ContributorsModel
@{
    ViewData["Title"] = T["Contributors"];
}

<h1>@ViewData["Title"]</h1>
<div class="col-lg-8">
    <p>@T["Find everything a person has sent in or is named as the photographer or author of, for example when they ask what the archive holds about them, or ask for it to be deleted."]</p>
    <p>@T["On each contribution you can remove their name and email address, mark it as withdrawn, or move the item to the bin and delete it there for good. Backups keep older copies until they are replaced."]</p>
</div>

<form method="get" role="search" class="row g-2 mb-3 col-lg-8">
    <div class="col">
        <label for="contributor-search" class="visually-hidden">@T["Name or email address"]</label>
        <input id="contributor-search" type="search" name="q" value="@Model.Text" class="form-control" placeholder="@T["Name or email address"]" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">@T["Search"]</button>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Text))
{
    @if (Model.NamedInItems.Count > 0)
    {
        <h2 class="h5">@T["Named in what curators wrote"]</h2>
        <p class="form-text">@T["In the rights holder, credit, received from or internal notes of these items. Correct or remove the text on the item."]</p>
        <ul class="mb-4">
            @foreach (var item in Model.NamedInItems)
            {
                <li>
                    <a asp-page="/Admin/Items/Edit" asp-route-id="@item.Id">@ArchiveItem.ShownTitle(T, item.Title)</a>
                    @if (item.DeletedAt is not null)
                    {
                        <span class="badge text-bg-dark">@T["In the bin"]</span>
                    }
                </li>
            }
        </ul>
    }

    @if (Model.Notes.Count > 0)
    {
        <h2 class="h5">@T["Notes from visitors"]</h2>
        <p class="form-text">@T["Sent through “Do you know more about this?”. Remove the name and email address, or delete the note, under “Notes from visitors”."]</p>
        <ul class="mb-4">
            @foreach (var note in Model.Notes)
            {
                <li class="text-break">
                    @note.Name
                    @if (note.Email is { } email)
                    {
                        <span class="text-muted small">@email</span>
                    }
                    · <a asp-page="/Admin/Notes/Index" asp-route-show="All" asp-route-item="@note.ArchiveItemId" asp-fragment="note-@note.Id">@ArchiveItem.ShownTitle(T, note.ArchiveItem.Title)</a>
                    · <span class="text-muted small">@Dates.Day(note.ReceivedAt)</span>
                    @if (note.ArchiveItem.DeletedAt is not null)
                    {
                        <span class="badge text-bg-dark">@T["In the bin"]</span>
                    }
                </li>
            }
        </ul>
    }

    @if (Model.Results.Count == 0)
    {
        <p class="text-muted">@T["No contributions match."]</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">@T["Contributor"]</th>
                        <th scope="col">@T["Item"]</th>
                        <th scope="col">@T["Status"]</th>
                        <th scope="col" class="d-none d-md-table-cell">@T["Sent in"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contribution in Model.Results)
                    {
                        <tr>
                            <td class="text-break">
                                @contribution.ContributorName
                                @if (contribution.ContributorEmail is not null)
                                {
                                    <br /><span class="text-muted small">@contribution.ContributorEmail</span>
                                }
                                @if (contribution.RightsHolder is not null)
                                {
                                    <br /><span class="text-muted small">@T["Photographer or author: {0}", contribution.RightsHolder]</span>
                                }
                            </td>
                            <td><a asp-page="/Admin/Items/Edit" asp-route-id="@contribution.ArchiveItemId">@ArchiveItem.ShownTitle(T, contribution.ArchiveItem.Title)</a></td>
                            <td>
                                @if (contribution.ArchiveItem.DeletedAt is null)
                                {
                                    <partial name="_StatusBadge" model="contribution.ArchiveItem.Status" />
                                }
                                else
                                {
                                    <span class="badge text-bg-dark">@T["In the bin"]</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">@Dates.Day(contribution.SubmittedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
