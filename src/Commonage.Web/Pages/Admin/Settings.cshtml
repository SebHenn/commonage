@page
@model Commonage.Web.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = T["Archive settings"];
}

<h1>@ViewData["Title"]</h1>

<form method="post" enctype="multipart/form-data" class="col-lg-8" data-warn-unsaved="@(ModelState.IsValid ? "" : "dirty")" data-send-once>
    <partial name="_ErrorSummary" />

    <fieldset class="mb-4">
        <legend class="h4">@T["Your archive"]</legend>
        <div class="mb-3">
            <label asp-for="Input.Name" class="form-label"></label>
            <input asp-for="Input.Name" class="form-control" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Tagline" class="form-label"></label>
            <input asp-for="Input.Tagline" class="form-control" aria-describedby="tagline-help" />
            <span asp-validation-for="Input.Tagline" class="text-danger"></span>
            <div id="tagline-help" class="form-text">@T["A few words about what this archive is, for example: Photos and memories from Lindenau."]</div>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Intro" class="form-label"></label>
            <textarea asp-for="Input.Intro" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Input.Intro" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label for="Logo" class="form-label">@T["Logo"]</label>
            @if (Model.CurrentLogoId is { } logoId)
            {
                <div class="mb-2"><img src="/branding/@logoId/logo" alt="" class="settings-logo" /></div>
            }
            <input id="Logo" type="file" name="Logo" accept="@Commonage.Web.Media.ImageFormats.AcceptAttribute" class="form-control" aria-describedby="logo-help"
                   data-choose-text="@T["Choose a logo"]" data-none-text="@T["No file chosen"]" />
            <span data-valmsg-for="Logo" data-valmsg-replace="true" class="text-danger">@(ViewData.ModelState["Logo"]?.Errors.FirstOrDefault()?.ErrorMessage)</span>
            <div id="logo-help" class="form-text">@T["JPEG, PNG, TIFF or WebP, at most {0} MB. It is also used as the browser tab's icon.", Commonage.Web.Operations.LogoImages.MaxBytes / 1024 / 1024]</div>
            @if (Model.CurrentLogoId is not null)
            {
                <div class="form-check mt-2">
                    <input asp-for="Input.RemoveLogo" class="form-check-input" />
                    <label asp-for="Input.RemoveLogo" class="form-check-label"></label>
                </div>
            }
        </div>
        <div class="mb-3">
            <label asp-for="Input.AccentColor" class="form-label"></label>
            <input asp-for="Input.AccentColor" type="color" class="form-control form-control-color" />
            <span asp-validation-for="Input.AccentColor" class="text-danger"></span>
            <div class="form-check mt-2">
                <input asp-for="Input.UseStandardColor" class="form-check-input" />
                <label asp-for="Input.UseStandardColor" class="form-check-label"></label>
            </div>
        </div>
    </fieldset>

    <fieldset class="mb-4">
        <legend class="h4">@T["Pages about your archive"]</legend>
        <p class="form-text">@T["Plain text. Web and email addresses become links. A page you leave empty is not shown."]</p>
        <div class="mb-3">
            <label asp-for="Input.About" class="form-label"></label>
            <textarea asp-for="Input.About" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Input.About" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Contact" class="form-label"></label>
            <textarea asp-for="Input.Contact" class="form-control" rows="4" aria-describedby="contact-help"></textarea>
            <span asp-validation-for="Input.Contact" class="text-danger"></span>
            <div id="contact-help" class="form-text">@T["Contributors are promised they can ask for removal. Say how: an email address, a phone number or a meeting place."]</div>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Privacy" class="form-label"></label>
            <textarea asp-for="Input.Privacy" class="form-control" rows="16" aria-describedby="privacy-help"></textarea>
            <span asp-validation-for="Input.Privacy" class="text-danger"></span>
            <div id="privacy-help" class="form-text">@T["This describes what Commonage itself stores. It is a template and not legal advice: adapt it to what your group does."]</div>
            <div class="form-check mt-2">
                <input asp-for="Input.PrivacyReviewed" class="form-check-input" />
                <label asp-for="Input.PrivacyReviewed" class="form-check-label"></label>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Imprint" class="form-label"></label>
            <textarea asp-for="Input.Imprint" class="form-control" rows="5" aria-describedby="imprint-help"></textarea>
            <span asp-validation-for="Input.Imprint" class="text-danger"></span>
            <div id="imprint-help" class="form-text">@T["Whether you need one depends on your country. In Germany, for example, most websites do."]</div>
            <div class="form-check mt-2">
                <input asp-for="Input.ImprintNotNeeded" class="form-check-input" />
                <label asp-for="Input.ImprintNotNeeded" class="form-check-label"></label>
            </div>
        </div>
    </fieldset>

    <fieldset class="mb-4">
        <legend class="h4">@T["Language, time and visibility"]</legend>
        <div class="mb-3">
            <label asp-for="Input.DefaultLanguage" class="form-label"></label>
            <select asp-for="Input.DefaultLanguage" class="form-select" aria-describedby="language-help">
                @foreach (var language in Model.Languages)
                {
                    <option value="@language" lang="@language">@SupportedLanguages.NameOf(language)</option>
                }
            </select>
            <span asp-validation-for="Input.DefaultLanguage" class="text-danger"></span>
            <div id="language-help" class="form-text">@T["For visitors whose browser asks for no language this archive offers."]</div>
        </div>
        <div class="mb-3">
            <label asp-for="Input.ContentLanguage" class="form-label"></label>
            <select asp-for="Input.ContentLanguage" class="form-select" aria-describedby="content-language-help">
                <option value="@DateLanguages.Several">@T["Several languages, none of them most"]</option>
                @foreach (var language in SupportedLanguages.AllLanguages)
                {
                    <option value="@language" lang="@language">@SupportedLanguages.NameOf(language)</option>
                }
            </select>
            <span asp-validation-for="Input.ContentLanguage" class="text-danger"></span>
            <div id="content-language-help" class="form-text">@T["The language most items are described in. Item pages tell browsers and screen readers which language their text is in, so that it is read aloud correctly, and dates written in it are understood."]</div>
        </div>
        <fieldset class="mb-3" id="Input_OtherContentLanguages" tabindex="-1" aria-describedby="date-languages-help">
            <legend class="form-label fs-6">@T["Dates can also be written in"]</legend>
            @* The main language is always read, so it is not offered again. *@
            @foreach (var language in Model.DateLanguageChoices.Where(l => l != Model.Input.ContentLanguage))
            {
                <div class="form-check">
                    <input type="checkbox" name="Input.OtherContentLanguages" value="@language" id="date-language-@language" class="form-check-input"
                           checked="@Model.Input.OtherContentLanguages.Contains(language)" />
                    <label for="date-language-@language" class="form-check-label" lang="@language">@SupportedLanguages.NameOf(language)</label>
                </div>
            }
            <span asp-validation-for="Input.OtherContentLanguages" class="text-danger"></span>
            <div id="date-languages-help" class="form-text">@T["Dates are always understood in the language above and in the language of whoever types them. In other languages, a month name can mean a different month: listopad is November in Polish, but October in Croatian."]</div>
        </fieldset>
        <div class="mb-3">
            <label asp-for="Input.TimeZone" class="form-label"></label>
            <select asp-for="Input.TimeZone" class="form-select" aria-describedby="timezone-help">
                <option value="">@T["The server's clock"]</option>
                @foreach (var zone in Model.TimeZones)
                {
                    <option value="@zone">@zone</option>
                }
            </select>
            <span asp-validation-for="Input.TimeZone" class="text-danger"></span>
            <div id="timezone-help" class="form-text">@T["For the times shown to curators, such as in the activity log."]</div>
        </div>
        <div class="mb-3">
            <label asp-for="Input.DefaultRightsUri" class="form-label"></label>
            <select asp-for="Input.DefaultRightsUri" class="form-select" aria-describedby="rights-default-help">
                <option value="">@T["Not decided yet"]</option>
                @foreach (var uri in RightsOptions.All)
                {
                    <option value="@uri">@RightsOptions.Label(T, uri)</option>
                }
            </select>
            <span asp-validation-for="Input.DefaultRightsUri" class="text-danger"></span>
            <div id="rights-default-help" class="form-text">@T["If you do not know yet, choosing that it is not checked is honest. A free licence is only yours to give for what you hold the rights to."]</div>
        </div>
        <div class="form-check mb-3">
            <input asp-for="Input.AllowSearchEngines" class="form-check-input" aria-describedby="search-engines-help" />
            <label asp-for="Input.AllowSearchEngines" class="form-check-label"></label>
            <div id="search-engines-help" class="form-text">@T["Without this, search engines are asked to leave the archive out. Anyone with a link can still open it."]</div>
        </div>
        <div class="form-check mb-3">
            <input asp-for="Input.LargePhotos" class="form-check-input" aria-describedby="large-photos-help" />
            <label asp-for="Input.LargePhotos" class="form-check-label"></label>
            <div id="large-photos-help" class="form-text">@T["Visitors can open a photo at about 3000 pixels, to read a letter or look at a face. Without this they only get a smaller one, about 1600 pixels, and the archive saves the disk space. The original stays private either way, and larger versions have no location data or other embedded details either."]</div>
        </div>
        <div class="form-check mb-3">
            <input asp-for="Input.AcceptVisitorNotes" class="form-check-input" aria-describedby="visitor-notes-help" />
            <label asp-for="Input.AcceptVisitorNotes" class="form-check-label"></label>
            <div id="visitor-notes-help" class="form-text">@T["Visitors can then send the curators more about an item, a correction, or a request to take it down. Only curators read it, under “Notes from visitors”. Name and email address are optional, and the privacy page should say that the archive keeps them."]</div>
        </div>
    </fieldset>

    <fieldset class="mb-4">
        <legend class="h4">@T["Logging in"]</legend>
        <div class="form-check mb-3">
            <input asp-for="Input.RequireTwoFactor" class="form-check-input" aria-describedby="two-factor-help" />
            <label asp-for="Input.RequireTwoFactor" class="form-check-label"></label>
            <div id="two-factor-help" class="form-text">@T["After their password, curators and admins then type a code from an app on their phone, so a stolen password alone is not enough. Each of them sets it up the next time they open these pages, you too. Someone who loses their phone and their recovery codes needs an admin to turn the app off for them."]</div>
        </div>
    </fieldset>

    <fieldset class="mb-4">
        <legend class="h4">@T["How long records are kept"]</legend>
        <p class="form-text mt-0">@T["Data protection laws such as the GDPR ask that personal data is kept no longer than it is needed. Backups keep older copies until they are replaced."]</p>
        <div class="mb-3 col-md-6">
            <label asp-for="Input.ActivityLogKeptYears" class="form-label"></label>
            <select asp-for="Input.ActivityLogKeptYears" class="form-select" aria-describedby="activity-kept-help">
                <option value="0">@T["Always"]</option>
                @foreach (var years in Commonage.Web.Domain.ArchiveSettings.ActivityLogYearChoices)
                {
                    <option value="@years">@T.Plural("{0, plural, one {For # year} other {For # years}}", years)</option>
                }
            </select>
            <span asp-validation-for="Input.ActivityLogKeptYears" class="text-danger"></span>
            <div id="activity-kept-help" class="form-text">@T["The log names the accounts that changed something. Older entries are deleted, and the log notes that it was shortened."]</div>
        </div>
        <div class="mb-3 col-md-6">
            <label asp-for="Input.RejectedKeptMonths" class="form-label"></label>
            <select asp-for="Input.RejectedKeptMonths" class="form-select" aria-describedby="rejected-kept-help">
                <option value="0">@T["Until a curator deletes them"]</option>
                @foreach (var months in Commonage.Web.Domain.ArchiveSettings.RejectedMonthChoices)
                {
                    <option value="@months">@T.Plural("{0, plural, one {For # month after the decision} other {For # months after the decision}}", months)</option>
                }
            </select>
            <span asp-validation-for="Input.RejectedKeptMonths" class="text-danger"></span>
            <div id="rejected-kept-help" class="form-text">@T["They hold the contributor's name and email address, and material that will not be published. Afterwards they go to the bin, and are deleted for good 30 days later."]</div>
        </div>
    </fieldset>

    <button type="submit" class="btn btn-primary">@T["Save"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
