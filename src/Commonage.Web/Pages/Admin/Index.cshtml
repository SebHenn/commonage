@page
@model Commonage.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = T["Manage archive"];
}

@if (User.IsInRole(Commonage.Web.Identity.Roles.Admin))
{
    <partial name="_GettingStarted" model="Model.GettingStarted" />
    <partial name="_ArchiveHealthNotices" model="Model.Health" />
}

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <h1 class="me-auto mb-0">@T["Items"]</h1>
    @if (Model.HasCollections)
    {
        <a asp-page="/Admin/Items/AddMany" class="btn btn-outline-primary">@T["Add many photos"]</a>
        <a asp-page="/Admin/Items/Edit" class="btn btn-primary">@T["New item"]</a>
    }
</div>

@if (Model.WaitingCount > 0 && Model.Status != ItemStatus.Submitted)
{
    <div class="alert alert-info" role="status">
        <a asp-page="/Admin/Index" asp-route-status="@ItemStatus.Submitted" class="alert-link">@T["Contributions waiting for review: {0}", Model.WaitingCount]</a>
    </div>
}

@if (!Model.HasCollections)
{
    <p>@T["Items belong to a collection."] <a asp-page="/Admin/Collections/Edit">@T["Create your first collection"]</a></p>
}
else
{
    <form method="get" role="search" class="row g-2 mb-3 align-items-end">
        <div class="col-12 col-md-4">
            <label for="admin-search" class="form-label small mb-1">@T["Search items"]</label>
            <input id="admin-search" type="search" name="q" value="@Model.Text" class="form-control" />
        </div>
        <div class="col-6 col-md-4">
            <label for="admin-status" class="form-label small mb-1">@T["Status"]</label>
            <select id="admin-status" name="status" class="form-select">
                <option value="">@T["All statuses"]</option>
                <option value="@ItemStatus.Draft" selected="@(Model.Status == ItemStatus.Draft)">@T["Draft"]</option>
                <option value="@ItemStatus.Published" selected="@(Model.Status == ItemStatus.Published)">@T["Published"]</option>
                <option value="@ItemStatus.Submitted" selected="@(Model.Status == ItemStatus.Submitted)">@T["Submitted"]</option>
                <option value="@ItemStatus.Rejected" selected="@(Model.Status == ItemStatus.Rejected)">@T["Rejected"]</option>
                <option value="@ItemStatus.Withdrawn" selected="@(Model.Status == ItemStatus.Withdrawn)">@T["Withdrawn"]</option>
            </select>
        </div>
        <div class="col-6 col-md-4">
            <label for="admin-collection" class="form-label small mb-1">@T["Collection"]</label>
            <select id="admin-collection" name="collection" asp-items="Model.CollectionOptions" class="form-select">
                <option value="">@T["All collections"]</option>
            </select>
        </div>
        <div class="col-6 col-md-4">
            <label for="admin-tag" class="form-label small mb-1">@T["Tag"]</label>
            <input id="admin-tag" type="search" name="tag" value="@Model.Tag" class="form-control" />
        </div>
        <div class="col-6 col-md-4">
            <label for="admin-needs" class="form-label small mb-1">@T["Still needs"]</label>
            <select id="admin-needs" name="needs" class="form-select">
                <option value="">@T["Anything"]</option>
                <option value="@ItemNeed.Title" selected="@(Model.Needs == ItemNeed.Title)">@T["A title"]</option>
                <option value="@ItemNeed.Description" selected="@(Model.Needs == ItemNeed.Description)">@T["A description"]</option>
                <option value="@ItemNeed.Date" selected="@(Model.Needs == ItemNeed.Date)">@T["A date"]</option>
                <option value="@ItemNeed.Tags" selected="@(Model.Needs == ItemNeed.Tags)">@T["Tags"]</option>
                <option value="@ItemNeed.Photos" selected="@(Model.Needs == ItemNeed.Photos)">@T["Photos"]</option>
                <option value="@ItemNeed.PreviewFailed" selected="@(Model.Needs == ItemNeed.PreviewFailed)">@T["A working preview"]</option>
                <option value="@ItemNeed.Rights" selected="@(Model.Needs == ItemNeed.Rights)">@T["A rights statement"]</option>
                <option value="@ItemNeed.AltText" selected="@(Model.Needs == ItemNeed.AltText)">@T["Photo descriptions"]</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label for="admin-sort" class="form-label small mb-1">@T["Sort by"]</label>
            <select id="admin-sort" name="sort" class="form-select">
                <option value="@AdminItemSort.LastChanged" selected="@(Model.Filter.EffectiveSort == AdminItemSort.LastChanged)">@T["Last changed"]</option>
                <option value="@AdminItemSort.OldestFirst" selected="@(Model.Filter.EffectiveSort == AdminItemSort.OldestFirst)">@T["Oldest first"]</option>
                <option value="@AdminItemSort.Title" selected="@(Model.Filter.EffectiveSort == AdminItemSort.Title)">@T["Title"]</option>
            </select>
        </div>
        <div class="col-6 col-md-2 d-flex flex-wrap gap-2 align-items-center">
            <button type="submit" class="btn btn-outline-primary">@T["Search"]</button>
            @if (Model.HasFilters)
            {
                <a asp-page="/Admin/Index">@T["Clear filters"]</a>
            }
        </div>
    </form>

    @if (Model.Items.TotalCount == 0)
    {
        <p class="text-muted">@(Model.HasFilters ? T["No items match."] : T["There are no items yet."])</p>
    }
    else
    {
        @* The table is not inside this form, because each row's checkbox joins it by name, and the search form stays what it is. *@
        <form method="post" id="bulk-form" asp-page="/Admin/Items/Bulk" class="bulk-bar d-flex flex-wrap gap-2 align-items-end mb-3">
            <input type="hidden" name="back" value="@Model.ListUrl" />
            <div>
                <label for="bulk-action" class="form-label small mb-1">@T["Change many at once"]</label>
                <select id="bulk-action" name="action" class="form-select">
                    <option value="@Commonage.Web.Pages.Admin.Items.BulkAction.Publish">@T["Publish"]</option>
                    <option value="@Commonage.Web.Pages.Admin.Items.BulkAction.AddTags">@T["Add tags"]</option>
                    <option value="@Commonage.Web.Pages.Admin.Items.BulkAction.SetDate">@T["Set the date"]</option>
                    <option value="@Commonage.Web.Pages.Admin.Items.BulkAction.MoveToCollection">@T["Move to a collection"]</option>
                    <option value="@Commonage.Web.Pages.Admin.Items.BulkAction.SetRights">@T["Set the rights statement"]</option>
                </select>
            </div>
            <button type="submit" name="scope" value="selected" class="btn btn-outline-primary">@T["For the ticked items"]</button>
            <button type="submit" name="scope" value="all" class="btn btn-outline-primary">@T["For all in this list: {0}", Model.Items.TotalCount]</button>
        </form>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">
                            <span class="visually-hidden">@T["Choose"]</span>
                            <input type="checkbox" class="form-check-input" data-tick-all="selected" aria-label="@T["Tick all on this page"]" hidden />
                        </th>
                        <th scope="col"><span class="visually-hidden">@T["Photos"]</span></th>
                        <th scope="col">@T["Title"]</th>
                        <th scope="col" class="d-none d-md-table-cell">@T["Collection"]</th>
                        <th scope="col">@T["Status"]</th>
                        <th scope="col" class="d-none d-md-table-cell">@T["Last changed"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items.Items)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" class="form-check-input" name="selected" value="@item.Id" form="bulk-form" aria-label="@T["Choose: {0}", ArchiveItem.ShownTitle(T, item.Title)]" />
                            </td>
                            <td class="admin-list-picture">
                                @if (item.ThumbnailMediaFileId is { } thumbnail)
                                {
                                    <img src="/admin/media/@thumbnail/thumbnail" alt="" class="rounded" loading="lazy" />
                                }
                            </td>
                            <td>
                                <a asp-page="/Admin/Items/Edit" asp-route-id="@item.Id" asp-route-back="@Model.ListUrl">@ArchiveItem.ShownTitle(T, item.Title)</a>
                                @if (item.FirstFileName is not null)
                                {
                                    <span class="d-block small text-muted text-break">@item.FirstFileName</span>
                                }
                                @if (item.HasIdenticalFile)
                                {
                                    <span class="badge text-bg-warning d-table mt-1">@T["The archive already has this file"]</span>
                                }
                                @if (item.PhotoCount > 1)
                                {
                                    <span class="d-block small text-muted">@T["Photos: {0}", item.PhotoCount]</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">@item.CollectionTitle</td>
                            <td><partial name="_StatusBadge" model="item.Status" /></td>
                            <td class="d-none d-md-table-cell">@Dates.Moment(item.UpdatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.Items" />
    }
}
