@page
@model Commonage.Web.Pages.Admin.Contributions.IndexModel
@{
    ViewData["Title"] = T["Contribution links"];
}

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <h1 class="me-auto mb-0">@ViewData["Title"]</h1>
    @if (Model.HasCollections)
    {
        <a asp-page="Edit" class="btn btn-primary">@T["New link"]</a>
    }
</div>

<p class="col-lg-8">@T["Anyone with a contribution link can send in photos and stories for a collection. Share it with a group, put it in a newsletter or on a poster. What people send in waits for your review and is never public before you publish it."]</p>

@if (!Model.HasCollections)
{
    <p>@T["Contributions go into a collection."] <a asp-page="/Admin/Collections/Edit">@T["Create your first collection"]</a></p>
}
else if (Model.Links.Count == 0)
{
    <p class="text-muted">@T["There are no contribution links yet."]</p>
}
else
{
    <ul class="list-unstyled">
        @foreach (var link in Model.Links)
        {
            <li class="card mb-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <h2 class="h5 mb-0 me-auto"><a asp-page="Edit" asp-route-id="@link.Id">@link.Title</a></h2>
                        @if (link.IsActive)
                        {
                            <span class="badge text-bg-success">@T["Open"]</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">@T["Closed"]</span>
                        }
                    </div>
                    <p class="text-muted small mb-2">
                        @T["Collection: {0}", link.CollectionTitle] ·
                        @T["Contributions: {0}", link.ContributionCount]
                        @if (link.WaitingCount > 0)
                        {
                            <text>·</text> <a asp-page="/Admin/Index" asp-route-status="@ItemStatus.Submitted">@T["Waiting for review: {0}", link.WaitingCount]</a>
                        }
                    </p>
                    @if (link.IsActive)
                    {
                        <p id="link-@link.Id" class="font-monospace small text-break mb-2" aria-label="@T["Address of the link"]">@Model.AddressOf(link)</p>
                        <button type="button" class="btn btn-sm btn-outline-secondary" hidden data-copy-from="link-@link.Id" data-done-text="@T["Copied"]" aria-describedby="copy-status-@link.Id">@T["Copy the link"]</button>
                        <a asp-page="Poster" asp-route-id="@link.Id" class="btn btn-sm btn-outline-secondary">@T["Poster to print"]</a>
                        <span id="copy-status-@link.Id" class="small ms-2" role="status"></span>
                    }
                </div>
            </li>
        }
    </ul>
}
