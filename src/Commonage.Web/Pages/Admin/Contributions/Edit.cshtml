@page "{id:int?}"
@model Commonage.Web.Pages.Admin.Contributions.EditModel
@{
    ViewData["Title"] = Model.LinkId is null ? T["New contribution link"] : T["Edit contribution link"];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Admin/Index">@T["Items"]</a></li>
        <li class="breadcrumb-item"><a asp-page="Index">@T["Contribution links"]</a></li>
    </ol>
</nav>

<h1>@ViewData["Title"]</h1>

<form method="post" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" aria-describedby="title-help" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
        <div id="title-help" class="form-text">@T["The heading contributors see, for example: Share your photos of the Mill Street flood"]</div>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Introduction" class="form-label"></label>
        <textarea asp-for="Input.Introduction" class="form-control" rows="4" aria-describedby="introduction-help"></textarea>
        <span asp-validation-for="Input.Introduction" class="text-danger"></span>
        <div id="introduction-help" class="form-text">@T["What you are looking for, and who you are."]</div>
    </div>
    <div class="mb-3">
        <label asp-for="Input.CollectionId" class="form-label"></label>
        <select asp-for="Input.CollectionId" asp-items="Model.CollectionOptions" class="form-select" aria-describedby="collection-help">
            <option value="">@T["Choose a collection"]</option>
        </select>
        <span asp-validation-for="Input.CollectionId" class="text-danger"></span>
        <div id="collection-help" class="form-text">@T["Contributions are added to this collection once you publish them."]</div>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Input.IsActive" class="form-check-input" aria-describedby="active-help" />
        <label asp-for="Input.IsActive" class="form-check-label"></label>
        <div id="active-help" class="form-text">@T["A closed link shows “not found”. You can open it again at any time."]</div>
    </div>
    <button type="submit" class="btn btn-primary">@T["Save"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
