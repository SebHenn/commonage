@page
@model Commonage.Web.Pages.Admin.Stories.IndexModel
@using Commonage.Web.Domain
@{
    ViewData["Title"] = T["Stories"];
}

<h1>@ViewData["Title"]</h1>
<p class="text-muted col-lg-8">@T["A story puts text and items in an order of your choice. Visitors cannot read stories yet."]</p>

<form method="post" asp-page-handler="Create" class="row g-2 align-items-end col-lg-8 mb-4" data-send-once>
    <partial name="_ErrorSummary" />
    <div class="col-sm-8">
        <label asp-for="NewTitle" class="form-label">@T["Title of the new story"]</label>
        <input asp-for="NewTitle" class="form-control" maxlength="@Story.TitleMaxLength" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">@T["New story"]</button>
    </div>
</form>

@if (Model.Stories.Count == 0)
{
    <p class="text-muted">@T["There are no stories yet."]</p>
}
else
{
    <ol class="list-group">
        @for (var index = 0; index < Model.Stories.Count; index++)
        {
            var story = Model.Stories[index];
            <li id="story-@story.Id" class="list-group-item d-flex flex-wrap gap-2 align-items-center">
                <span class="d-flex flex-wrap gap-2 align-items-baseline me-auto">
                    <a asp-page="/Admin/Stories/Edit" asp-route-id="@story.Id" class="text-break">@ArchiveItem.ShownTitle(T, story.Title)</a>
                    <span class="badge @(story.Status == StoryStatus.Published ? "text-bg-success" : "text-bg-secondary")">@(story.Status == StoryStatus.Published ? T["Published"] : T["Draft"])</span>
                    <small class="text-muted">@T.Plural("{0, plural, one {# part} other {# parts}}", story.BlockCount)</small>
                    @if (story.HiddenCount > 0)
                    {
                        <small class="text-muted">@T.Plural("{0, plural, one {# item not shown to visitors} other {# items not shown to visitors}}", story.HiddenCount)</small>
                    }
                </span>
                <form method="post" class="d-flex flex-wrap gap-1">
                    <button type="submit" asp-page-handler="MoveEarlier" asp-route-id="@story.Id" class="btn btn-sm btn-outline-secondary"
                            disabled="@(index == 0)" aria-label="@T["Earlier: {0}", story.Title]">@T["Earlier"]</button>
                    <button type="submit" asp-page-handler="MoveLater" asp-route-id="@story.Id" class="btn btn-sm btn-outline-secondary"
                            disabled="@(index == Model.Stories.Count - 1)" aria-label="@T["Later: {0}", story.Title]">@T["Later"]</button>
                </form>
            </li>
        }
    </ol>
}
