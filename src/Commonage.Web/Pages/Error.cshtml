@page "{code:int?}"
@model ErrorModel
@{
    ViewData["Title"] = Model.Status switch
    {
        404 => T["Page not found"],
        403 => T["No access"],
        400 => T["The request could not be processed"],
        429 => T["Too many attempts"],
        507 => T["The archive's storage is full"],
        _ => T["Something went wrong"],
    };
}

<div class="col-lg-8">
    <h1>@ViewData["Title"]</h1>
    @switch (Model.Status)
    {
        case 404:
            <p>@T["This page does not exist, or it is not public (any more)."]</p>
            break;
        case 403:
            <p>@T["Your account cannot open this page. Ask an admin if you need it."]</p>
            break;
        case 400:
            <p>@T["Please go back, reload the page and try again."]</p>
            break;
        case 429:
            <p>@T["Too many attempts came from your network in the last hour. Please try again later."]</p>
            break;
        case 507:
            <p>@T["The archive cannot take in anything new at the moment, so what you sent was not saved. Please go back and try again later. If it keeps happening, tell the people who run this archive."]</p>
            break;
        default:
            <p>@T["The archive could not complete this request. Please try again in a moment. If it keeps happening, tell the people who run this archive."]</p>
            @if (Model.RequestId is not null)
            {
                <p class="text-muted small">@T["Reference for them: {0}", Model.RequestId]</p>
            }
            break;
    }
    <p><a asp-page="/Index">@T["Go to the start page"]</a> · <a asp-page="/Search">@T["Search the archive"]</a></p>
</div>
