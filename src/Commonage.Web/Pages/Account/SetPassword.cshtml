@page
@model Commonage.Web.Pages.Account.SetPasswordModel
@{
    ViewData["Title"] = T["Choose your password"];
}

<div class="row">
    <div class="col-md-8 col-lg-5">
        <h1>@ViewData["Title"]</h1>
        <p>@T["For the account {0}. Use at least 6 characters with an uppercase and a lowercase letter, a digit and a character such as - or !. A longer password is safer than a complicated one.", Model.Email!]</p>
        <form method="post" asp-route-user="@Request.Query["user"]" asp-route-code="@Request.Query["code"]">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            @* Lets password managers save the new password for the right account. *@
            <input type="text" name="username" value="@Model.Email" autocomplete="username" hidden readonly />
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">@T["Save password"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
