@page
@model Commonage.Web.Pages.Account.TwoFactorModel
@{
    ViewData["Title"] = T["Log in with an authenticator app"];
}

<div class="row">
    <div class="col-lg-8">
        <h1>@ViewData["Title"]</h1>

        @if (Model.NewRecoveryCodes.Count > 0)
        {
            <section class="recovery-box" aria-labelledby="codes-heading">
                <h2 id="codes-heading" class="h4">@T["Your recovery codes"]</h2>
                <p>@T["Without your phone, each of these codes lets you log in once. Write them down or print them, and keep them somewhere safe, away from your phone. They are shown only now."]</p>
                <ol id="recovery-codes" class="recovery-codes">
                    @foreach (var code in Model.NewRecoveryCodes)
                    {
                        <li><code>@code</code></li>
                    }
                </ol>
                <button type="button" class="btn btn-sm btn-outline-secondary" hidden data-copy-from="recovery-codes" data-done-text="@T["Copied"]" aria-describedby="copy-status">@T["Copy"]</button>
                <span id="copy-status" class="small ms-2" role="status"></span>
                <p class="mt-3 mb-0"><a asp-page="/Admin/Index">@T["Go on to managing the archive"]</a></p>
            </section>
        }

        @if (!Model.Enabled)
        {
            @if (Model.Required)
            {
                <p class="alert alert-warning" role="status">@T["This archive requires an authenticator app for everyone who manages it. Set it up here before you go on."]</p>
            }
            <p>@T["After your password, the login then asks for a code from an app on your phone. Someone who finds out your password cannot log in without your phone."]</p>
            <form method="post" asp-page-handler="Enable">
                <partial name="_ErrorSummary" />
                <ol class="setup-steps">
                    <li>@T["Install an authenticator app on your phone, if you have none yet. Many work, for example Aegis, 2FAS, Google Authenticator or Microsoft Authenticator."]</li>
                    <li>
                        @T["In the app, add an account and scan this code."]
                        <div class="qr-frame my-2">@Model.QrCode</div>
                        <p class="mb-1">@T["Or type this key into the app:"]</p>
                        <p><code class="setup-key">@Model.Key</code></p>
                    </li>
                    <li>
                        <label asp-for="Input.Code" class="form-label">@T["Type the six digits the app shows now:"]</label>
                        <input asp-for="Input.Code" class="form-control setup-code" autocomplete="one-time-code" inputmode="numeric" spellcheck="false" />
                        <span asp-validation-for="Input.Code" class="text-danger"></span>
                    </li>
                </ol>
                <button type="submit" class="btn btn-primary">@T["Turn on"]</button>
            </form>
        }
        else
        {
            <p class="alert alert-info" role="status">@T["Your account asks for a code from your authenticator app when you log in."]</p>
            <p>@T.Plural("{0, plural, =0 {You have no recovery codes left. Create new ones, in case you lose your phone.} one {You have one recovery code left.} other {You have # recovery codes left.}}", Model.RecoveryCodesLeft)</p>

            <form method="post">
                <partial name="_ErrorSummary" />
                <input type="text" name="username" value="@User.Identity?.Name" autocomplete="username" hidden readonly />
                <div class="mb-3 col-md-8">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-describedby="password-why" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                    <div id="password-why" class="form-text">@T["Needed for both buttons, so that nobody else can use a computer you left logged in."]</div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" asp-page-handler="RecoveryCodes" class="btn btn-outline-primary">@T["Create new recovery codes"]</button>
                    <button type="submit" asp-page-handler="TurnOff" class="btn btn-outline-danger">
                        @(Model.Required ? T["Set up on a new phone"] : T["Turn off"])
                    </button>
                </div>
                <p class="form-text mt-2">@T["New recovery codes replace the old ones."]</p>
            </form>
        }
    </div>
</div>
