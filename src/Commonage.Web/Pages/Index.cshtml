@page
@model IndexModel
@{
    ViewData["Title"] = Model.Identity.Name;
}

<div class="home-intro">
    <h1>@Model.Identity.Name</h1>
    @if (Model.Identity.Text(ArchiveTextKind.Tagline) is { } tagline)
    {
        <p class="lead mb-2 prose">@tagline</p>
    }
    @if (Model.Identity.Text(ArchiveTextKind.Intro) is { } intro)
    {
        <p class="text-preserve-lines prose">@Commonage.Web.Forms.PlainText.WithLinks(intro)</p>
    }
</div>

<form method="get" asp-page="/Search" role="search" class="input-group mb-4">
    <label for="home-search" class="visually-hidden">@T["Search the archive"]</label>
    <input id="home-search" type="search" name="q" class="form-control" placeholder="@T["Search the archive"]" />
    <button type="submit" class="btn btn-primary">@T["Search"]</button>
</form>

@if (Model.Recent.Count > 0)
{
    <section class="home-section" aria-labelledby="recent-heading">
        <h2 id="recent-heading">@T["Recently added"]</h2>
        <partial name="_ItemCards" model="Model.Recent" />
    </section>
}

<section class="home-section" aria-labelledby="collections-heading">
    <h2 id="collections-heading">@T["Collections"]</h2>
    @if (Model.Collections.Count == 0)
    {
        <p class="text-muted">@T["The archive has no collections yet."]</p>
    }
    else
    {
        <partial name="_CollectionCards" model="Model.Collections" />
    }
</section>

@* A single decade is no timeline. *@
@if (Model.Decades.Count > 1)
{
    <section class="home-section" aria-labelledby="decades-heading">
        <h2 id="decades-heading">@T["Through the decades"]</h2>
        <div class="col-lg-8">
            <partial name="_DecadeTimeline" model="new Commonage.Web.Search.DecadeTimelineView(Model.Decades, KeepSearch: false)" />
        </div>
    </section>
}

@if (Model.HelpWanted)
{
    <section class="home-section" aria-labelledby="help-heading">
        <h2 id="help-heading">@T["Can you help?"]</h2>
        <p>@T["Some items wait for someone who knows more about them."] <a asp-page="/Help">@T["See what the curators ask about"]</a></p>
    </section>
}

@if (Model.Tags.Count > 0)
{
    <section class="home-section" aria-labelledby="tags-heading">
        <h2 id="tags-heading">@T["Browse by tag"]</h2>
        <ul class="list-unstyled d-flex flex-wrap gap-2">
            @foreach (var tag in Model.Tags)
            {
                <li><a asp-page="/Search" asp-route-tag="@tag" class="badge rounded-pill text-bg-light border tag-link">@tag</a></li>
            }
        </ul>
        @if (Model.TagKinds.Count > 0)
        {
            <p class="d-flex flex-wrap gap-3">
                @foreach (var kind in Model.TagKinds)
                {
                    <a asp-page="/TagIndex" asp-route-kind="@Commonage.Web.Domain.TagKinds.Slug(kind)">@(kind == TagKind.Place ? T["All places"] : T["All people"])</a>
                }
            </p>
        }
    </section>
}
