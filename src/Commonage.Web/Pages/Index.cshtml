@page
@model IndexModel
@{
    ViewData["Title"] = T["Collections"];
}

<h1>@T["Collections"]</h1>

@if (Model.Collections.Count == 0)
{
    <p class="text-muted">@T["The archive has no collections yet."]</p>
}
else
{
    <ul class="list-unstyled">
        @foreach (var collection in Model.Collections)
        {
            <li class="mb-3">
                <h2 class="h4 mb-1"><a asp-page="/Collections/Details" asp-route-id="@collection.Id">@collection.Title</a></h2>
                @if (!string.IsNullOrWhiteSpace(collection.Description))
                {
                    <p class="mb-1">@collection.Description</p>
                }
                <small class="text-muted">@T["Items: {0}", collection.PublishedItemCount]</small>
            </li>
        }
    </ul>
}
