<Project>
  <PropertyGroup>
    <!-- The released version. Raise it together with CHANGELOG.md. -->
    <Version>0.1.1</Version>
    <!-- Warnings fail the build on CI only, so local experiments stay quick. -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
